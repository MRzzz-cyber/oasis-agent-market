{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "oasis-ai-demo",
  "compatibility_date": "2026-11-11",
  "main": "./worker.js",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ],
    "not_found_handling": "single-page-application"
  }
}
