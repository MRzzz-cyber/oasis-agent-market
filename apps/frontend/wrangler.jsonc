{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "oasis-agent-market",
  "compatibility_date": "2026-11-11",
  "main": "./worker.js",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },
  "previews": {},
  "durable_objects": {
    "bindings": [
      {
        "name": "ACCOUNTS",
        "class_name": "AccountStore"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-accounts",
      "new_sqlite_classes": [
        "AccountStore"
      ]
    }
  ],
  "build": {
    "command": "npm ci --include=dev --no-audit --no-fund && npm run build:wallet",
    "cwd": "../.."
  }
}
